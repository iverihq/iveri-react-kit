{
  "name": "@iveri/react-kit",
  "version": "0.12.0",
  "description": "Shared React UI primitives for Iveri admin apps.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iverihq/iveri-react-kit.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.18.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./map": {
      "types": "./dist/map/index.d.ts",
      "default": "./dist/map/index.js"
    },
    "./shell": {
      "types": "./dist/shell/index.d.ts",
      "default": "./dist/shell/index.js"
    },
    "./theme.css": "./styles/theme.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "theme": "node scripts/build-theme.mjs",
    "build": "pnpm clean && node scripts/build-theme.mjs --check && tsc -p tsconfig.build.json && node scripts/verify-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite --config preview/vite.config.ts"
  },
  "prettier": "@iveri/prettier-config",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/noto-sans-georgian": "^5.3.0",
    "intl-messageformat": "^12.1.4"
  },
  "peerDependencies": {
    "maplibre-gl": ">=5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@iveri/eslint-config": "^0.2.3",
    "@iveri/prettier-config": "^0.1.0",
    "@iveri/tokens": "^0.2.0",
    "@iveri/tsconfig": "^0.2.1",
    "@tailwindcss/node": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "maplibre-gl": "^6.17.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "rimraf": "^6.1.4",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
