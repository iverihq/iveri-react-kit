{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The react variant sets `noEmit` because it is written for Vite apps, where Vite owns the
    // emit. This is a library, so it has to emit its own JavaScript and declarations.
    "noEmit": false,
    // Only the build has a `rootDir`. Type-checking also covers the test-runner config and the
    // gallery beside `src/`, and a `rootDir` there would reject them for a reason — where emitted
    // files land — that does not apply when nothing is emitted.
    "rootDir": "./src",
    "declaration": true,
    // Maps would point at `src/`, which is not published.
    "declarationMap": false,
    "sourceMap": false,
    "allowImportingTsExtensions": false
  },
  // Only `src` is emitted. The specs, the test setup, the gallery and the configs are type-checked
  // by `tsconfig.json` and never shipped.
  "include": ["src/**/*"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.spec.tsx", "src/test-setup.ts"]
}
